# Copy to `.env` in this directory and fill in. Never commit `.env`.
# Restart Expo after changes.

# Optional: existing app URLs (see app.config.js)
# EXPO_PUBLIC_API_URL=https://api.example.com
# EXPO_PUBLIC_SIS_API_URL=https://prod-dataserv.concordia.ca/SIS/api

# Concordia Open Data — register at https://opendata.concordia.ca/admin/register.php
# Dashboard "User" → CONCORDIA_OPENDATA_USER
# Dashboard "Key"  → CONCORDIA_OPENDATA_API_KEY
CONCORDIA_OPENDATA_USER=
CONCORDIA_OPENDATA_API_KEY=
